# %% [markdown]
# # Multi-DB research chat: token counting and context budgets (step 10)
# Context limits are measured in TOKENS, not characters. A `TokenCounter` is a tiny adapter around whatever
# tokenizer matches your model (Hugging Face tokenizer for Gemma, tiktoken for OpenAI, or any function such
# as a provider's count-tokens call). The default is a rough characters/4 estimate, so everything works
# without extra dependencies, but swap in the real tokenizer for accurate budgets.
# No dependency on the other research_*.py files.

# %%
from __future__ import annotations

import math
from typing import Callable, Optional, Protocol

class TokenCounter(Protocol):
    def count(self, text: str) -> int: ...
    def truncate(self, text: str, max_tokens: int) -> str: ...

def _truncate_by_search(counter, text: str, max_tokens: int) -> str:
    """Longest prefix of `text` that fits `max_tokens` (works with any monotonic count function)."""
    if max_tokens <= 0:
        return ""
    if counter.count(text) <= max_tokens:
        return text
    lo, hi = 0, len(text)
    while lo < hi:
        mid = (lo + hi + 1) // 2
        if counter.count(text[:mid]) <= max_tokens:
            lo = mid
        else:
            hi = mid - 1
    return text[:lo].rstrip()

class CharTokenCounter:
    """Rough estimate (default ~4 characters per token for English). Good enough to avoid gross overflows."""
    def __init__(self, chars_per_token: float = 4.0):
        self.cpt = chars_per_token

    def count(self, text: str) -> int:
        return math.ceil(len(text) / self.cpt) if text else 0

    def truncate(self, text: str, max_tokens: int) -> str:
        return text[: max(0, int(max_tokens * self.cpt))]
