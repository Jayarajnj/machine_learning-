# %% [markdown]
# # Multi-DB research chat: token counting and context budgets (step 10)
# Context limits are measured in TOKENS, not characters. A `TokenCounter` is a tiny adapter around whatever
# tokenizer matches your model (Hugging Face tokenizer for Gemma, tiktoken for OpenAI, or any function such
# as a provider's count-tokens call). The default is a rough characters/4 estimate, so everything works
# without extra dependencies, but swap in the real tokenizer for accurate budgets.
# No dependency on the other research_*.py files.

# %%
from __future__ import annotations

import math
from typing import Callable, Optional, Protocol

class TokenCounter(Protocol):
    def count(self, text: str) -> int: ...
    def truncate(self, text: str, max_tokens: int) -> str: ...

def _truncate_by_search(counter, text: str, max_tokens: int) -> str:
    """Longest prefix of `text` that fits `max_tokens` (works with any monotonic count function)."""
    if max_tokens <= 0:
        return ""
    if counter.count(text) <= max_tokens:
        return text
    lo, hi = 0, len(text)
    while lo < hi:
        mid = (lo + hi + 1) // 2
        if counter.count(text[:mid]) <= max_tokens:
            lo = mid
        else:
            hi = mid - 1
    return text[:lo].rstrip()

class CharTokenCounter:
    """Rough estimate (default ~4 characters per token for English). Good enough to avoid gross overflows."""
    def __init__(self, chars_per_token: float = 4.0):
        self.cpt = chars_per_token

    def count(self, text: str) -> int:
        return math.ceil(len(text) / self.cpt) if text else 0

    def truncate(self, text: str, max_tokens: int) -> str:
        return text[: max(0, int(max_tokens * self.cpt))]

class WhitespaceTokenCounter:
    """One token per whitespace-separated word. Handy for tests and quick experiments."""
    def count(self, text: str) -> int:
        return len(text.split())

    def truncate(self, text: str, max_tokens: int) -> str:
        return " ".join(text.split()[: max(0, max_tokens)])

class HFTokenCounter:
    """Exact counts with a Hugging Face tokenizer: pass a tokenizer object, or a model id to load lazily
    (e.g. HFTokenCounter("google/gemma-2-2b-it")). Anything with encode(text, add_special_tokens=False) and
    decode(ids) works."""
    def __init__(self, tokenizer_or_name):
        self._name = tokenizer_or_name if isinstance(tokenizer_or_name, str) else None
        self._tok = None if self._name else tokenizer_or_name

    def _t(self):
        if self._tok is None:
            from transformers import AutoTokenizer
            self._tok = AutoTokenizer.from_pretrained(self._name)
        return self._tok

    def count(self, text: str) -> int:
        return len(self._t().encode(text, add_special_tokens=False)) if text else 0

    def truncate(self, text: str, max_tokens: int) -> str:
        if max_tokens <= 0:
            return ""
        ids = self._t().encode(text, add_special_tokens=False)
        return text if len(ids) <= max_tokens else self._t().decode(ids[:max_tokens])



class TiktokenCounter:
    """OpenAI-style counts via tiktoken (pip install tiktoken). Give an encoding name ("o200k_base") or a model name."""
    def __init__(self, name: str = "o200k_base"):
        import tiktoken
        try:
            self._enc = tiktoken.get_encoding(name)
        except ValueError:
            self._enc = tiktoken.encoding_for_model(name)

    def count(self, text: str) -> int:
        return len(self._enc.encode(text)) if text else 0

    def truncate(self, text: str, max_tokens: int) -> str:
        ids = self._enc.encode(text)
        return text if len(ids) <= max_tokens else self._enc.decode(ids[: max(0, max_tokens)])

class CallableTokenCounter:
    """Wrap any count function (for example a provider's count-tokens API). `truncate` is found by search
    unless you pass your own; note that an API-based counter makes truncation slower."""
    def __init__(self, count_fn: Callable[[str], int], truncate_fn: Optional[Callable[[str, int], str]] = None):
        self._count, self._truncate = count_fn, truncate_fn

    def count(self, text: str) -> int:
        return self._count(text) if text else 0

    def truncate(self, text: str, max_tokens: int) -> str:
        return self._truncate(text, max_tokens) if self._truncate else _truncate_by_search(self, text, max_tokens)

# %% [markdown]
# ## Helpers for chat messages

# %%
def count_messages(counter, messages: list, per_message: int = 6) -> int:
    """Tokens of a message list, including a small per-message allowance for the chat template."""
    return sum(counter.count(m["content"]) + per_message for m in messages)

def fit_messages(counter, messages: list, max_tokens: int, per_message: int = 6) -> list:
    """Newest messages that fit in `max_tokens`, in original order. If even the newest alone is too long 
it is
    truncated; if the budget is too small for any message the result is empty."""
    if max_tokens <= per_message:
        return []
    kept: list = []
    used = 0
    for m in reversed(messages):
        n = counter.count(m["content"]) + per_message
        if used + n > max_tokens:
            if kept:
                break
            room = max_tokens - per_message
            m = {**m, "content": counter.truncate(m["content"], room).rstrip() + " …"}
            n = counter.count(m["content"]) + per_message
        kept.append(m)
        used += n
    return kept[::-1]

# %% [markdown]
# ## Offline smoke test

# %%
def _smoke_test():
    c = CharTokenCounter()
    assert c.count("") == 0 and c.count("abcd") == 1 and c.count("abcde") == 2
    assert c.truncate("x" * 100, 10) == "x" * 40 and c.truncate("abc", 0) == ""

    w = WhitespaceTokenCounter()
    assert w.count("a b  c\nd") == 4 and w.truncate("a b c d e", 3) == "a b c"

    class FakeTok:                                   # stands in for a Hugging Face tokenizer
        def encode(self, text, add_special_tokens=False):
            return text.split()

        def decode(self, ids):
            return " ".join(ids)
    h = HFTokenCounter(FakeTok())
    assert h.count("one two three") == 3 and h.truncate("one two three four", 2) == "one two"
    assert h.truncate("one two", 5) == "one two" and h.truncate("x", 0) == ""

    cc = CallableTokenCounter(lambda t: len(t.split()))                    # truncation found by search
    assert cc.count("a b c") == 3 and cc.truncate("a b c d e", 3) == "a b c" and cc.truncate("a b", 9) == "a b"
    assert cc.truncate("a b c", 0) == ""

    msgs = [{"role": "user", "content": "w " * 50}, {"role": "assistant", "content": "w " * 50},
            {"role": "user", "content": "w " * 50}]
    assert count_messages(w, msgs, per_message=6) == 168
    fitted = fit_messages(w, msgs, 120, per_message=6)                      # 56 each -> the two newest fit
    assert fitted == msgs[1:]
    one = fit_messages(w, msgs, 30, per_message=6)                          # even one is too long -> truncated newest
    assert len(one) == 1 and one[0]["role"] == "user" and count_messages(w, one, 6) <= 31
    assert fit_messages(w, msgs, 5) == [] and fit_messages(w, [], 100) == []
    print("All token-budget checks passed.")


if __name__ == "__main__" or "get_ipython" in globals():
    _smoke_test()

